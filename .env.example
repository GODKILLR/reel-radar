# ---- Required ----

# Apify API token: https://console.apify.com/settings/integrations
APIFY_TOKEN=

# Pooled Postgres connection string (Neon, Supabase, or Vercel Postgres).
DATABASE_URL=

# Shared secrets. Generate with: openssl rand -hex 32
CRON_SECRET=
WEBHOOK_SECRET=

# Encrypts users' own collector keys at rest (AES-256-GCM). At least 32 random
# characters:  openssl rand -hex 32   Without it, "bring your own key" is off.
# KEEP THIS SAFE: if it is lost, every stored key becomes unreadable and users
# must reconnect. Never change it casually.
KEY_ENCRYPTION_SECRET=

# Accounts: users sign up with email + password. Session cookies are signed
# with WEBHOOK_SECRET (or AUTH_SECRET if you set one).
# Comma-separated emails that become admins when they sign up. Admins get the
# /admin page (users, plans, featured accounts, collection cost) and are not
# metered. You can also promote an existing user:
#   npm run make-admin -- you@example.com --claim-legacy
ADMIN_EMAILS=

# Public URL of this app. Apify posts scrape results back here, so it must be
# reachable from the internet. Vercel sets this automatically in production.
APP_BASE_URL=https://your-app.vercel.app

# ---- Alerts (optional; both can be set) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=alerts@yourdomain.com

# ---- Cost / freshness tuning (optional, defaults shown) ----

# Which scraper to use:
#   lowcost  - sones/instagram-posts-scraper-lowcost, $0.0003/post + $0.005/run.
#              ~9x cheaper, same view counts, and returns profile pictures.
#              No reach figure and no trending-audio data.
#   official - apify/instagram-post-scraper, $0.0027/post. Adds videoViewCount
#              (reach / replay ratio) and musicInfo (trending audio), and is a
#              first-party actor, so more dependable long term.
APIFY_ACTOR=lowcost

# Hot tier: re-scraped every cycle. This is the main cost driver.
HOT_WINDOW_DAYS=2
HOT_LIMIT=8

# Warm tier: older posts, swept this often.
WARM_WINDOW_DAYS=30
WARM_LIMIT=60
WARM_EVERY_HOURS=72

# One-time history fetch when an account is first added.
BACKFILL_WINDOW_DAYS=30
# Capped at the plan depth (100 reels) whatever you set here.
BACKFILL_LIMIT=100

# Keeping the database inside a small (free) plan. See src/lib/cleanup.ts.
DB_LIMIT_MB=1024            # size of your database plan
CLEANUP_AT_PERCENT=70       # only above this fill does clean-up DELETE accounts/links
ORPHAN_DAYS=30              # delete accounts nobody has tracked for this long
INACTIVE_DAYS=90            # drop tracking of users unseen this long (user + email stay)
METRICS_KEEP=6              # history snapshots kept per reel
NON_REELS_KEPT=20           # photos/carousels kept per account

# A post counts as an outlier at this multiple of its account median.
OUTLIER_THRESHOLD=3
OUTLIER_MIN_AGE_HOURS=24
OUTLIER_BASELINE_SIZE=30
