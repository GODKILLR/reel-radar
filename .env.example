# ---- Required ----

# Apify API token: https://console.apify.com/settings/integrations
APIFY_TOKEN=

# Pooled Postgres connection string (Neon, Supabase, or Vercel Postgres).
DATABASE_URL=

# Shared secrets. Generate with: openssl rand -hex 32
CRON_SECRET=
WEBHOOK_SECRET=

# Password for the dashboard itself. REQUIRED for any public deployment --
# without it the dashboard and its write APIs are open to anyone with the URL.
# Leave blank for local development to skip the login screen.
DASHBOARD_PASSWORD=

# Public URL of this app. Apify posts scrape results back here, so it must be
# reachable from the internet. Vercel sets this automatically in production.
APP_BASE_URL=https://your-app.vercel.app

# ---- Alerts (optional; both can be set) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=alerts@yourdomain.com

# ---- Cost / freshness tuning (optional, defaults shown) ----

# Which scraper to use:
#   lowcost  - sones/instagram-posts-scraper-lowcost, $0.0003/post + $0.005/run.
#              ~9x cheaper, same view counts, and returns profile pictures.
#              No reach figure and no trending-audio data.
#   official - apify/instagram-post-scraper, $0.0027/post. Adds videoViewCount
#              (reach / replay ratio) and musicInfo (trending audio), and is a
#              first-party actor, so more dependable long term.
APIFY_ACTOR=lowcost

# Hot tier: re-scraped every cycle. This is the main cost driver.
HOT_WINDOW_DAYS=2
HOT_LIMIT=8

# Warm tier: older posts, swept this often.
WARM_WINDOW_DAYS=30
WARM_LIMIT=60
WARM_EVERY_HOURS=72

# One-time history fetch when an account is first added.
BACKFILL_WINDOW_DAYS=30
BACKFILL_LIMIT=150

# A post counts as an outlier at this multiple of its account median.
OUTLIER_THRESHOLD=3
OUTLIER_MIN_AGE_HOURS=24
OUTLIER_BASELINE_SIZE=30
